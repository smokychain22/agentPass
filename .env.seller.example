# RepoDiet seller runtime — environment contract (NAMES ONLY).
#
# Copy to .env.seller and fill in real values on the host. Never commit the
# filled file. The runtime fails closed when required secrets are absent
# rather than starting and silently reporting itself online.

# --- Public identifiers (not secret) ---------------------------------------
REPODIET_PRODUCTION_URL=
REPODIET_OKX_AGENT_ID=
REPODIET_OKX_RUNTIME_ROLE=

# --- Runtime paths (Railway: one /persistent volume) -----------------------
REPODIET_OKX_RUNTIME_ROOT=
XDG_DATA_HOME=
HOME=

# --- Heartbeat authentication (SECRET) -------------------------------------
# Shared secret for POST /api/internal/okx/seller-heartbeat. Minimum 32 chars.
REPODIET_OKX_RUNTIME_HEARTBEAT_SECRET=

# --- Heartbeat tuning (optional) -------------------------------------------
REPODIET_SELLER_HEARTBEAT_INTERVAL_MS=
REPODIET_SELLER_HEARTBEAT_TTL_SECONDS=

# --- A2A provider binding (optional; not secret) ----------------------------
# @okxweb3/a2a-node exposes exactly four providers: codex, claude, hermes,
# openclaw. codex/claude are rejected at startup (development tools only).
# Defaults to openclaw, the documented host-agnostic Agent host. Set to
# "hermes" only if this deployment should bind that provider instead.
REPODIET_OKX_A2A_PROVIDER=

# --- OKX / OnchainOS credentials -------------------------------------------
# The onchainos and okx-a2a CLIs authenticate through their own credential
# home, which is mounted as a persistent volume. See the runbook: this is a
# ONE-TIME interactive login performed inside the container, not a value
# pasted here. Do not copy a machine-bound keyring from a workstation.

# --- GitHub App (SECRET) — only required once execution runs in-container ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=

# --- Durable store (SECRET, optional) --------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
