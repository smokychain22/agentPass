# RepoDiet seller runtime — environment contract (NAMES ONLY).
#
# Copy to .env.seller and fill in real values on the host. Never commit the
# filled file. The runtime fails closed when required secrets are absent
# rather than starting and silently reporting itself online.

# --- Public identifiers (not secret) ---------------------------------------
REPODIET_PRODUCTION_URL=
REPODIET_OKX_AGENT_ID=
REPODIET_OKX_RUNTIME_ROLE=

# --- Runtime paths (Railway: one /persistent volume) -----------------------
REPODIET_OKX_RUNTIME_ROOT=
XDG_DATA_HOME=
HOME=

# --- Heartbeat authentication (SECRET) -------------------------------------
# Shared secret for POST /api/internal/okx/seller-heartbeat. Minimum 32 chars.
# Same value as Vercel's copy of this variable.
REPODIET_OKX_RUNTIME_HEARTBEAT_SECRET=

# --- OpenClaw Gateway authentication (SECRET) -------------------------------
# Shared token for the OpenClaw Gateway (ws://127.0.0.1:18789) and the
# okx-a2a OpenClaw plugin/daemon client. Minimum 16 chars — see
# scripts/seller-runtime-supervisor.ts. The supervisor mirrors this into
# OKX_A2A_OPENCLAW_GATEWAY_TOKEN itself; do not set that second name here.
OPENCLAW_GATEWAY_TOKEN=

# --- Heartbeat tuning (optional) -------------------------------------------
REPODIET_SELLER_HEARTBEAT_INTERVAL_MS=
REPODIET_SELLER_HEARTBEAT_TTL_SECONDS=

# --- A2A provider binding (optional; not secret) ----------------------------
# @okxweb3/a2a-node exposes exactly four providers: codex, claude, hermes,
# openclaw. codex/claude are rejected at startup (development tools only).
# Defaults to openclaw, the documented host-agnostic Agent host. Set to
# "hermes" only if this deployment should bind that provider instead.
REPODIET_OKX_A2A_PROVIDER=

# --- OKX / OnchainOS credentials -------------------------------------------
# The onchainos and okx-a2a CLIs authenticate through their own credential
# home, which is mounted as a persistent volume. See the runbook: this is a
# ONE-TIME interactive login performed inside the container, not a value
# pasted here. Do not copy a machine-bound keyring from a workstation.

# --- GitHub App (SECRET) — only required once execution runs in-container ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
# Not secret, but required alongside the five values above: src/lib/github-app/
# config.ts's isGitHubAppConfigured() also checks GITHUB_APP_SLUG, and it is
# not among the seven values already staged in Fly. Canonical value:
# repodiet-operator (the app slug in https://github.com/apps/repodiet-operator).
GITHUB_APP_SLUG=

# --- Durable store (SECRET, optional) --------------------------------------
# Audited 2026-07-30: NOT required by anything scripts/seller-runtime-
# supervisor.ts or scripts/repodiet-seller-runtime.ts actually calls today —
# only the separate GitHub Actions analysis worker (worker/src/index.ts) and
# the Next.js app's optional Redis-backed store use these. Left here,
# unset, in case a future in-container dispatch path needs it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Model-provider credential: deliberately NOT listed here ----------------
# Audited 2026-07-30: no model-provider API key (Anthropic/OpenAI/etc.) is
# required by anything that currently runs in this container, and one must
# NOT be added as a way to make the OpenClaw Gateway "answer" inbound
# messages — that would let a generic model, not RepoDiet's own code, act as
# the production ASP responder, which is explicitly prohibited. The correct
# fix for the Gateway's agent turn otherwise having nothing to answer with is
# activating openclaw-plugins/repodiet-a2a-bridge (built, tested, not yet
# wired into supervisor startup — see its module docblock and
# docs/SELLER_RUNTIME_DEPLOYMENT.md), not a model credential.
