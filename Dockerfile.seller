# RepoDiet seller runtime — always-online production process for Agent 9636.
#
# This image contains no secrets and no credentials. The OKX CLIs it depends
# on authenticate against a persisted home volume (see the deployment
# runbook), so the image itself is safe to rebuild and redistribute.
FROM node:22-bookworm-slim

# tini gives us a real init so SIGTERM reaches the runtime and shutdown is
# clean rather than a 10-second SIGKILL.
RUN apt-get update \
 && apt-get install -y --no-install-recommends tini gosu curl ca-certificates git \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first so application edits do not invalidate the layer. tsx
# (a devDependency) is required at runtime — see the CMD at the bottom of
# this file — so this deliberately does not pass --omit=dev. @playwright/test
# is also a devDependency purely for the repo's own e2e test suite; this
# container never runs it, so PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD skips its
# postinstall browser-binary download (100s of MB from a separate CDN,
# unrelated to and far slower than the npm registry) — this image has no use
# for Chromium/Firefox/WebKit and installing them would only inflate the
# image and slow every build for no runtime benefit.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Only what the seller runtime actually needs.
COPY tsconfig.json ./
COPY scripts ./scripts
COPY src ./src

# The official A2A CLI that the runtime shells out to for the XMTP client.
# Pinned deliberately: an unpinned agent CLI must not change under a live
# marketplace listing. The build FAILS if it is unavailable — a container
# missing a required executable must never reach production.
ARG OKX_A2A_VERSION=0.1.11
RUN npm install -g "@okxweb3/a2a-node@${OKX_A2A_VERSION}"  && okx-a2a --version

# OnchainOS — official Linux release, pinned and checksum-verified.
#
# Source: okx/onchainos-skills. The official README documents piping
# install.sh from `main` to sh; we deliberately do NOT do that in a
# production image, because an unpinned moving-main script could change
# what ships here without review. Instead we pin an immutable release tag,
# fetch that release's own published checksums.txt at build time, and cross-
# check it against a pinned expected value — so the checksum actually used to
# verify the binary is never an unexplained bare constant, and a change to
# the release (which should never happen for an immutable tag) is caught
# explicitly instead of silently trusted. The build fails closed if
# checksums.txt cannot be fetched, the asset is missing, more than one line
# matches, the published value disagrees with the pinned expectation, the
# downloaded binary's checksum does not match, or the binary cannot run.
ARG ONCHAINOS_RELEASE_TAG=v4.4.1
ARG ONCHAINOS_LINUX_ASSET=onchainos-x86_64-unknown-linux-gnu
ARG ONCHAINOS_LINUX_SHA256=a835c87dc13b1176924023ecb842e5dac9f84a2f5ddcb3e97f65299aac2cc3bb
RUN set -eu; \
    base="https://github.com/okx/onchainos-skills/releases/download/${ONCHAINOS_RELEASE_TAG}"; \
    curl -fsSL -o /tmp/onchainos-checksums.txt "${base}/checksums.txt"; \
    match_count=$(grep -c "  ${ONCHAINOS_LINUX_ASSET}\$" /tmp/onchainos-checksums.txt); \
    if [ "${match_count}" != "1" ]; then \
      echo "expected exactly one checksums.txt entry for ${ONCHAINOS_LINUX_ASSET} in release ${ONCHAINOS_RELEASE_TAG}, found ${match_count}" >&2; \
      exit 1; \
    fi; \
    published_sha256=$(grep "  ${ONCHAINOS_LINUX_ASSET}\$" /tmp/onchainos-checksums.txt | awk '{print $1}'); \
    if [ "${published_sha256}" != "${ONCHAINOS_LINUX_SHA256}" ]; then \
      echo "release ${ONCHAINOS_RELEASE_TAG} checksums.txt now publishes ${published_sha256} for ${ONCHAINOS_LINUX_ASSET}, but ${ONCHAINOS_LINUX_SHA256} was pinned — an immutable release tag must never change; refusing to install" >&2; \
      exit 1; \
    fi; \
    curl -fsSL -o /usr/local/bin/onchainos "${base}/${ONCHAINOS_LINUX_ASSET}"; \
    echo "${published_sha256}  /usr/local/bin/onchainos" | sha256sum -c -; \
    chmod +x /usr/local/bin/onchainos; \
    rm -f /tmp/onchainos-checksums.txt; \
    onchainos --version

# Provider binding: @okxweb3/a2a-node exposes exactly four providers — codex,
# claude, hermes, openclaw — with no generic process/webhook/MCP/HTTP-callback
# adapter. The officially supported host-agnostic path is the OpenClaw
# gateway plugin @okxweb3/a2a-openclaw (pinned and extracted further below,
# after the chown, so it lands root-owned like the bridge plugin).
ARG OPENCLAW_VERSION=2026.7.1-2
RUN npm install -g "openclaw@${OPENCLAW_VERSION}" && openclaw --version

# Non-root. The runtime writes only to its data root, which is a volume.
ENV REPODIET_OKX_RUNTIME_ROOT=/persistent/data/okx-runtimes     XDG_DATA_HOME=/persistent/data     HOME=/persistent/home     NODE_ENV=production
# Directories are created at RUNTIME by the entrypoint, because a Railway
# volume mounted at /persistent masks anything created here.
RUN chown -R node:node /app
# NOTE: no Docker VOLUME instruction. Railway rejects it at Dockerfile
# parse time ("docker VOLUME ... is not supported, use Railway Volumes").
# Persistence is attached by the platform at /persistent, and the
# entrypoint creates and chowns the directories once it is mounted.

# The RepoDiet A2A Bridge OpenClaw plugin — loaded via plugins.load.paths
# at /app/openclaw-plugins/repodiet-a2a-bridge (see
# scripts/seller-runtime-supervisor.ts's REPODIET_BRIDGE_PLUGIN_PATH).
# Copied AFTER the chown above, and deliberately NOT chowned to node:node:
# verified by direct reproduction that OpenClaw's own plugin loader refuses
# a plugins.load.paths entry owned by a non-root uid ("blocked plugin
# candidate: suspicious ownership ... expected uid=0 or root"). Root
# ownership of a read-only plugin directory is safe — the seller process
# (running as node) only ever reads these files, never writes them.
COPY openclaw-plugins ./openclaw-plugins

# @okxweb3/a2a-openclaw — the official OpenClaw-side gateway plugin. Pinned
# and checksum-verified at BUILD time, not installed at boot.
#
# Root cause of a real reproduced production incident: the previously-used
# boot-time `okx-a2a setup openclaw --release latest` (a) resolves "latest"
# freshly on every boot — when a newer @okxweb3/a2a-node release appeared on
# npm after this image pinned 0.1.10, that command silently attempted `npm
# install -g @okxweb3/a2a-node@latest` inside the running container, which
# hung past the supervisor's timeout on both a bandwidth-constrained dev
# sandbox AND on live Fly infrastructure — and (b) always ran `openclaw
# plugins install <spec> --force`, an unconditional network fetch, whenever
# the plugin was not yet installed (true on every fresh volume). A boot must
# never depend on npm registry availability. See docs/SELLER_RUNTIME_DEPLOYMENT.md
# for the full incident writeup.
#
# Fetched via `npm pack` (same trusted resolution path as the other pinned
# CLIs above) and cross-checked against the exact sha512 integrity npm's own
# registry publishes for this pinned version — verified directly with `npm
# view @okxweb3/a2a-openclaw@0.1.11 dist.integrity`, not guessed. The build
# fails closed on any mismatch, missing tarball, or extraction failure.
#
# Extracted to a plain image path (like the bridge plugin above), NOT
# installed via `openclaw plugins install` (which writes into
# $HOME/.openclaw/extensions — $HOME is /persistent/home, a volume mounted
# at runtime, so anything written there at build time would be masked once
# the real volume mounts). Instead this is loaded at boot via
# `plugins.load.paths` alongside the bridge plugin, and must stay
# root-owned for the same plugin-loader ownership check.
ARG OKX_A2A_OPENCLAW_PLUGIN_VERSION=0.1.11
ARG OKX_A2A_OPENCLAW_PLUGIN_INTEGRITY=sha512-Qc/TkdqVouIvAumR8wVbyeEk4/+oYBZAWYk3oEvffXINNFoh5LbIPjWZz/9R2jOfjq7uhz7uQOodxPJnEYPhdQ==
RUN set -eu; \
    cd /tmp; \
    npm pack "@okxweb3/a2a-openclaw@${OKX_A2A_OPENCLAW_PLUGIN_VERSION}" --silent >/tmp/pack-name.txt; \
    tarball="$(tail -n1 /tmp/pack-name.txt | tr -d '\r')"; \
    if [ ! -f "${tarball}" ]; then \
      echo "npm pack did not produce the expected tarball for @okxweb3/a2a-openclaw@${OKX_A2A_OPENCLAW_PLUGIN_VERSION}" >&2; \
      exit 1; \
    fi; \
    actual_integrity="sha512-$(node -e "process.stdout.write(require('crypto').createHash('sha512').update(require('fs').readFileSync('${tarball}')).digest('base64'))")"; \
    if [ "${actual_integrity}" != "${OKX_A2A_OPENCLAW_PLUGIN_INTEGRITY}" ]; then \
      echo "@okxweb3/a2a-openclaw@${OKX_A2A_OPENCLAW_PLUGIN_VERSION} tarball integrity mismatch: expected ${OKX_A2A_OPENCLAW_PLUGIN_INTEGRITY}, got ${actual_integrity} — refusing to install" >&2; \
      exit 1; \
    fi; \
    mkdir -p /app/openclaw-plugins/okx-a2a-openclaw; \
    tar -xzf "${tarball}" -C /app/openclaw-plugins/okx-a2a-openclaw --strip-components=1; \
    rm -f "${tarball}" /tmp/pack-name.txt; \
    test -f /app/openclaw-plugins/okx-a2a-openclaw/openclaw.plugin.json

# The extracted plugin's OWN internal Gateway client (a separate, unrelated
# connection from the one this supervisor makes) resolves gateway.auth.token
# through its own resolver, which only understands a plain string or the
# plugin-native {env:"VAR"} shorthand — never the {provider,source,id}
# SecretRef shape OpenClaw core (and this image's config) actually uses,
# confirmed by reading the plugin's real dist/index.js end to end: no
# plugin-specific token field exists to redirect through instead. This is a
# narrow, additive, checksum-guarded patch — see
# scripts/patch-okx-a2a-openclaw-token-resolver.ts for the full root-cause
# writeup and safety guarantees (it refuses to run, failing this build, if
# the plugin's dist/index.js does not match the exact sha256 this patch was
# written and reviewed against).
RUN node_modules/.bin/tsx scripts/patch-okx-a2a-openclaw-token-resolver.ts \
    /app/openclaw-plugins/okx-a2a-openclaw/dist/index.js

# Build-time proof that both plugins actually load and activate, not just
# that their files exist. Root cause this exists for: @okxweb3/a2a-openclaw
# declares a real runtime dependency on @sentry/node (see its own
# package.json), which this image never installed — the build above
# succeeds (it only extracts and checksum-verifies files), and the failure
# was only ever discovered live, when the Gateway actually tried to
# require() the plugin on repodiet-agent-9636. See
# docs/SELLER_RUNTIME_DEPLOYMENT.md ("Incident #5") for the full writeup.
# Confined to this one layer: HOME and OPENCLAW_GATEWAY_TOKEN are inline
# shell env assignments, never a Dockerfile ENV, so no placeholder value or
# scratch config is ever baked into the image or the real runtime's HOME.
RUN set -eu; \
    export HOME=/tmp/plugin-load-verify; \
    export OPENCLAW_GATEWAY_TOKEN="build-time-verification-placeholder-not-a-real-secret"; \
    mkdir -p "$HOME"; \
    node_modules/.bin/tsx scripts/verify-openclaw-plugins-load.ts; \
    rm -rf "$HOME"

# Literal Git SHA of the commit this image was built from.
#
# Supplied by the deploy (`--build-arg GIT_COMMIT=$(git rev-parse HEAD)`) and
# recorded two ways on purpose: the file survives an ssh session with no shell
# env, and the env var is readable by the runtime itself. Without it a deployed
# image can only be identified by fingerprinting source files, which proves
# "some commit containing symbol X" rather than "exactly this SHA" — a real gap
# hit on 2026-08-06 when verifying what was actually running in production.
#
# Defaults to "unknown" rather than failing the build, so an image built
# outside the deploy path stays usable and is HONESTLY labelled as
# unverifiable instead of silently inheriting a stale SHA.
#
# Placed last so a new SHA invalidates only this tiny layer, never the
# dependency, plugin-extraction or verification layers above.
ARG GIT_COMMIT=unknown
ENV REPODIET_BUILD_COMMIT=${GIT_COMMIT}
RUN printf '%s' "${GIT_COMMIT}" > /app/BUILD_COMMIT

# Proves the process is alive AND holding its instance lock — not merely running.
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD node -e "const fs=require('fs');const p=process.env.REPODIET_OKX_RUNTIME_ROOT+'/seller-9636/runtime.pid';if(!fs.existsSync(p))process.exit(1);const pid=Number(fs.readFileSync(p,'utf8').trim());try{process.kill(pid,0)}catch{process.exit(1)}"

COPY --chmod=0755 scripts/seller-entrypoint.sh /usr/local/bin/seller-entrypoint.sh
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/seller-entrypoint.sh"]
# Verified by direct reproduction: `npx tsx ...` does NOT exec into a single
# process — npx spawns through `npm exec` -> `sh -c` -> tsx's own CLI, and
# that chain does not forward SIGTERM to the innermost Node process. The
# container was killed by a raw, unhandled SIGTERM (exit 143) with no
# shutdown_started/shutdown_complete logged — the lock was never released.
# node_modules/.bin/tsx is itself a shell shim that ends in `exec`, so
# invoking it directly (bypassing npx) keeps this a single exec'd process
# from tini down, and SIGTERM reaches the runtime's own handler.
#
# scripts/seller-runtime-supervisor.ts is the actual PID under tini/gosu. It
# starts and supervises the OpenClaw Gateway as a managed foreground child
# (previously unsupervised — okx-a2a's own post-install gateway restart
# shells out to `systemctl --user`, which does not exist here) and only
# then spawns repodiet-seller-runtime.ts as a second managed child. Both are
# required children: a signal to this process is forwarded to both, and if
# either exits unexpectedly the supervisor tears the other down and exits
# non-zero rather than leaving a half-supervised container running.
CMD ["node_modules/.bin/tsx", "scripts/seller-runtime-supervisor.ts"]
