# RepoDiet seller runtime — always-online production process for Agent 9636.
#
# This image contains no secrets and no credentials. The OKX CLIs it depends
# on authenticate against a persisted home volume (see the deployment
# runbook), so the image itself is safe to rebuild and redistribute.
FROM node:22-bookworm-slim

# tini gives us a real init so SIGTERM reaches the runtime and shutdown is
# clean rather than a 10-second SIGKILL.
RUN apt-get update \
 && apt-get install -y --no-install-recommends tini ca-certificates git \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first so application edits do not invalidate the layer.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Only what the seller runtime actually needs.
COPY tsconfig.json ./
COPY scripts ./scripts
COPY src ./src

# The OKX CLIs the runtime shells out to for the official gate-check and the
# XMTP client. Pinning is intentional: an unpinned agent CLI must not change
# under a running marketplace listing.
ARG OKX_A2A_VERSION=latest
ARG ONCHAINOS_VERSION=latest
RUN npm install -g "@okxweb3/a2a-node@${OKX_A2A_VERSION}" || \
    echo "WARN: @okxweb3/a2a-node not installed at build time; mount or install at runtime"

# Non-root. The runtime writes only to its data root, which is a volume.
ENV REPODIET_OKX_RUNTIME_ROOT=/data/okx-runtimes \
    XDG_DATA_HOME=/data \
    HOME=/home/node \
    NODE_ENV=production
RUN mkdir -p /data /home/node && chown -R node:node /data /home/node /app
USER node
VOLUME ["/data", "/home/node"]

# Proves the process is alive AND holding its instance lock — not merely running.
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD node -e "const fs=require('fs');const p=process.env.REPODIET_OKX_RUNTIME_ROOT+'/seller-9636/runtime.pid';if(!fs.existsSync(p))process.exit(1);const pid=Number(fs.readFileSync(p,'utf8').trim());try{process.kill(pid,0)}catch{process.exit(1)}"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["npx", "tsx", "scripts/repodiet-seller-runtime.ts"]
